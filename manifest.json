{
  "manifest_version": 2,
  "name": "Exchange Calendar Sync",
  "version": "0.4.4",
  "description": "Two-way sync between an on-premises Exchange Server calendar and Thunderbird, via EWS.",
  "author": "Zareh Kasparian (with Claude Code support)",
  "applications": {
    "gecko": {
      "id": "exchange-calendar-sync@example.invalid",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "background": {
    "scripts": [
      "calendar/ews.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "webRequest",
    "webRequestBlocking",
    "https://*/*"
  ],
  "experiment_apis": {
    "exchangeCalendar": {
      "schema": "calendar/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["exchangeCalendar"]],
        "script": "calendar/provider.js"
      }
    }
  }
}
